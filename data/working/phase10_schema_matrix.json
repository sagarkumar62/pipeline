{
  "phase": "PHASE 10",
  "audit_type": "SCHEMA_MATRIX_AUDIT",
  "common_entity_schema": {
    "description": "Base entity schema shared across all 10 AI Orbit modules",
    "fields": [
      {
        "field_name": "id",
        "type": "str",
        "classification": "COMMON",
        "description": "Deterministic stable entity ID generated from entity_type + canonical_domain + canonical_name hash."
      },
      {
        "field_name": "entity_type",
        "type": "str",
        "classification": "COMMON",
        "description": "Discriminator enum: TOOL, COMPANY, AGENT, MCP, MODEL, ROBOT, DEVICE, NEWS, REPOSITORY, VIDEO."
      },
      {
        "field_name": "name",
        "type": "str",
        "classification": "COMMON",
        "description": "Primary canonical display name of the entity."
      },
      {
        "field_name": "description",
        "type": "Optional[str]",
        "classification": "COMMON",
        "description": "Factual 1-2 sentence description grounded in source evidence."
      },
      {
        "field_name": "url",
        "type": "str",
        "classification": "COMMON",
        "description": "Verified canonical primary website or repository URL."
      },
      {
        "field_name": "categories",
        "type": "List[str]",
        "classification": "COMMON",
        "description": "Taxonomy categories assigned to the entity."
      },
      {
        "field_name": "source",
        "type": "DiscoverySource",
        "classification": "SOURCE_METADATA",
        "description": "Primary discovery metadata (source name, URL, trust level, timestamp)."
      },
      {
        "field_name": "provenance",
        "type": "List[EvidenceSource]",
        "classification": "SOURCE_METADATA",
        "description": "Audit trail of evidence URLs supporting the factual claims of this entity."
      },
      {
        "field_name": "verification",
        "type": "VerificationResult",
        "classification": "VERIFICATION_METADATA",
        "description": "HTTP accessibility, identity match, domain match, page title, and meta description."
      },
      {
        "field_name": "logo",
        "type": "Optional[LogoMetadata]",
        "classification": "VERIFICATION_METADATA",
        "description": "Verified official logo URL, discovery source, and verification status."
      },
      {
        "field_name": "timestamps",
        "type": "EntityTimestamps",
        "classification": "COMMON",
        "description": "Record creation, update, and last verification timestamps."
      },
      {
        "field_name": "quality",
        "type": "QualityMetrics",
        "classification": "COMMON",
        "description": "Metadata completeness, verification score, description quality, composite quality score."
      }
    ]
  },
